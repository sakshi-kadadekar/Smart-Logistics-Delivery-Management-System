# ============================================

# Smart Logistics & Delivery Management System

# Environment Variables

# ============================================

# --------------------------------------------

# Gemini AI

# --------------------------------------------

# Get your own Gemini API key from Google AI Studio.

GEMINI_API_KEY="your_gemini_api_key_here"

# --------------------------------------------

# Application URL

# --------------------------------------------

# URL where the application is running.

# Local development example:

# http://localhost:5173

APP_URL="http://localhost:5173"

# --------------------------------------------

# Google Sheets Activity Logging

# --------------------------------------------

# Google Apps Script Web App URL.

# Replace this placeholder with your own URL

# in your local .env file.

GOOGLE_SHEET_URL="your_google_apps_script_webhook_url_here"

# --------------------------------------------

# Google Maps

# --------------------------------------------

# Google Maps Platform API key.

# IMPORTANT: Keep the real key in .env only.

GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# For Vite frontend applications:

VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"
